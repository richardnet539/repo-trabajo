FROM wordpress:6.1.1

# Pass the database configuration through arguments
ARG LIGA_DEBATE_DB_HOST
ARG LIGA_DEBATE_DB_NAME
ARG LIGA_DEBATE_DB_USER
ARG LIGA_DEBATE_DB_PASSWORD
ARG PROJECT_NAME

# Set environment variables for WordPress to configure itself
ENV WORDPRESS_DB_HOST=${LIGA_DEBATE_DB_HOST} \
    WORDPRESS_DB_NAME=${LIGA_DEBATE_DB_NAME} \
    WORDPRESS_DB_USER=${LIGA_DEBATE_DB_USER} \
    WORDPRESS_DB_PASSWORD=${LIGA_DEBATE_DB_PASSWORD} \
    PROJECT_NAME=${PROJECT_NAME}
    
WORKDIR /var/www/html

RUN mkdir ./wp-content/themes/${PROJECT_NAME}

COPY ./ ./wp-content/themes/${PROJECT_NAME}

# Default command from the WordPress image
CMD ["apache2-foreground"]
