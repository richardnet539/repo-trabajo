{
  "name": "liga-de-debate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build-css": "sass ./scss:./ && npm run minify-css",
    "watch-css": "sass --watch ./scss:./",
    "minify-css": "postcss ./style.css -o ./style.min.css",
    "start": "node dev/browsersync.js",
    "setup": "node dev/setup.js",
    "dev:linux": "npm run setup && concurrently \"npm run start\" \"npm run watch-css\" \"npm run minify-css\"",
    "dev:windows": "npm run setup && concurrently \"npm run start\" \"npm run watch-css\" \"npm run minify-css\"",
    "dev": "npm run dev:linux"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "sass": "^1.77.2"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "browser-sync": "^3.0.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^7.0.0",
    "cssnano": "^5.0.0",
    "postcss-cli": "^10.0.0"
  }
}
