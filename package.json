{
  "name": "liga-de-debate",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build-css": "sass ./scss:./",
    "watch-css": "sass --watch ./scss:./",
    "start": "node dev/browsersync.js",
    "setup": "node dev/setup.js",
    "dev:linux": "npm run setup && concurrently \"npm run start\" \"npm run watch-css\"",
    "dev:windows": "npm run setup && concurrently \"npm run start\" \"npm run watch-css\"",
    "dev": "npm run dev:linux"
  },
