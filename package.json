  "license": "ISC",
  "dependencies": {
    "sass": "^1.77.2"
  },
  "devDependencies": {
    "browser-sync": "^3.0.2",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^7.0.0"
  }
}
