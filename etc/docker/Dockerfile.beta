# Stage 1: Build
FROM wordpress:6.6-php8.2-apache AS build

ARG THEME_NAME

WORKDIR /usr/src/wordpress

# Adjust paths for the correct context
COPY / ./wp-content/themes/${THEME_NAME}/
COPY etc/config/wp-config.php ./wp-config.php

# Stage 2: Final
FROM registry.ctdesarrollo-sdr.org/presencia-web/nginx-fpm-8:latest

COPY etc/nginx/default.beta.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /tmp/nginx/client_body /tmp/nginx/proxy /tmp/nginx/fastcgi && \
    chown -R www-data:www-data /tmp/nginx && \
    chmod -R 755 /tmp/nginx

WORKDIR /var/www/html

COPY --from=build /usr/src/wordpress /var/www/html
COPY --from=build /usr/src/wordpress/wp-config.php /var/www/html/wp-config.php
COPY --from=build /usr/src/wordpress/wp-content/themes /var/www/html/wp-content/themes
COPY --from=build /usr/src/wordpress/wp-content/plugins /var/www/html/wp-content/plugins

# Combine all RUN commands into one to reduce layers
RUN mkdir -p /var/www/html/wp-content/upgrade && \
    chown -R www-data:www-data /var/www/html && \
    find /var/www/html -type d -exec chmod 755 {} \; && \
    find /var/www/html -type f -exec chmod 644 {} \; && \
    chown -R www-data:www-data /var/www/html/wp-content && \
    chmod -R 775 /var/www/html/wp-content

EXPOSE 80
