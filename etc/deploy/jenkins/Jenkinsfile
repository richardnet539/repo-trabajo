def slackResponse = slackSend(channel: "#ctsweb-builds", color: '#65A4F1', message: "Se está desplegando ${JOB_NAME} build #${BUILD_NUMBER}")

pipeline {
    agent any
    environment {
        /** GENERAL CONFIG **/
        THEME_NAME = "liga-de-debate"

        /** WEB SERVER **/
        SSH_HOST = "172.22.4.24"
        SSH_USER = "jenkins"
        SSH_PASS = credentials('ssh-pass-web')

        /** WORKING DIRECTORY **/
        SERVICES_DIRECTORY = "/home/cts-deus/services"
        WORKING_DIRECTORY  = "${SERVICES_DIRECTORY}/${THEME_NAME}"

        /** CONTAINER REGISTRY **/
        SERVER_REG         = "registry.ctdesarrollo-sdr.org/presencia-web"
        DOCKER_USER        = "jenkins"
        DOCKER_PASS        = credentials('registry-pass-docker')
        LATEST_THEME_IMAGE = "${SERVER_REG}/${THEME_NAME}:latest"

        /** THEME SOURCE DIRECTORY **/
        THEME_SOURCE_DIRECTORY = "${WORKSPACE}/wp-content/themes/${THEME_NAME}"
    }

    stages {
        stage('Build & Push Docker Image') {
            steps {
                echo '==== BUILD & PUSH DOCKER IMAGE ===='
                script {
                    // Check if container is running on the remote server
                    def containerRunningOutput = sh(
                        script: '''
                            sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "
                            docker ps -q -f name=${THEME_NAME}
                            "
                        ''',
                        returnStdout: true
                    ).trim()

                    // Extract the container ID from the output
                    def containerRunning = containerRunningOutput.find(/[0-9a-f]{12,64}/) ?: ''

                    if (containerRunning) {
                        echo "Container ${THEME_NAME} is already running. Skipping image build."
                    } else {
                        echo "Container ${THEME_NAME} is not running. Proceeding to build image."
                        // Proceed to build and push the image
                        sh 'docker login ${SERVER_REG} -u ${DOCKER_USER} -p ${DOCKER_PASS}'
                        sh 'docker build -f etc/docker/Dockerfile.beta --no-cache -t ${SERVER_REG}/${THEME_NAME}:${BRANCH_NAME}-${BUILD_ID} --build-arg THEME_NAME=${THEME_NAME} ${WORKSPACE}'
                        sh 'docker push ${SERVER_REG}/${THEME_NAME}:${BRANCH_NAME}-${BUILD_ID}'
                    }
                }
                echo '==== FINISHED DOCKER IMAGE ===='
            }
        }
        stage('Remote SSH Deploy') {
            steps {
                echo '==== REMOTE DEVELOPMENT DEPLOY ===='
                script {
                    def secrets = [[
                        path: "kv-presencia-web-sysadmin/development/databases/${THEME_NAME}",
                        engineVersion: 2,
                        secretValues: [
                            [envVar: 'WORDPRESS_DB_HOST', vaultKey: 'WORDPRESS_DB_HOST'],
                            [envVar: 'WORDPRESS_DB_NAME', vaultKey: 'WORDPRESS_DB_NAME'],
                            [envVar: 'WORDPRESS_DB_PASSWORD', vaultKey: 'WORDPRESS_DB_PASSWORD'],
                            [envVar: 'WORDPRESS_DB_USER', vaultKey: 'WORDPRESS_DB_USER']
                        ]
                    ]]
                    def configuration = [
                        vaultUrl: 'https://vault.ctdesarrollo-sdr.org',
                        vaultCredentialId: 'vault-teaching-management',
                        engineVersion: 2
                    ]

                    withVault(configuration: configuration, vaultSecrets: secrets) {
                        // Check if container is running
                        def containerRunningOutput = sh(
                            script: '''
                                sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "
                                docker ps -q -f name=${THEME_NAME}
                                "
                            ''',
                            returnStdout: true
                        ).trim()

                        // Extract the container ID from the output
                        def containerRunning = containerRunningOutput.find(/[0-9a-f]{12,64}/) ?: ''

                        if (containerRunning) {
                            echo "Container ${THEME_NAME} is already running. Skipping redeploy."
                            // Use rsync to copy theme files from Jenkins workspace to remote directory
                            sh '''
                                sshpass -p "${SSH_PASS}" rsync -avz -e "ssh -o StrictHostKeyChecking=no" ${THEME_SOURCE_DIRECTORY}/ ${SSH_USER}@${SSH_HOST}:${SERVICES_DIRECTORY}/${THEME_NAME}/themes/${THEME_NAME}/
                            '''
                        } else {
                            echo "Container ${THEME_NAME} is not running. Proceeding to deploy."
                            // Log in to the Docker registry on the remote server
                            sh 'sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "docker login ${SERVER_REG} -u ${DOCKER_USER} -p ${DOCKER_PASS}"'

                            // Remove existing container if it exists but is stopped
                            def containerExistsOutput = sh(
                                script: '''
                                    sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "
                                    docker ps -a -q -f name=${THEME_NAME}
                                    "
                                ''',
                                returnStdout: true
                            ).trim()

                            echo "containerExistsOutput: '${containerExistsOutput}'"

                            // Extract the container ID from the output
                            def containerExists = containerExistsOutput.find(/[0-9a-f]{12,64}/) ?: ''

                            if (containerExists) {
                                echo "Container ${THEME_NAME} exists but is not running. Removing it."
                                sh '''
                                    sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "
                                    docker rm ${THEME_NAME}
                                    "
                                '''
                            }

                            // Ensure the theme directory exists
                            sh '''
                                sshpass -p "${SSH_PASS}" ssh -T -o LogLevel=ERROR -o BatchMode=yes -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "mkdir -p ${SERVICES_DIRECTORY}/${THEME_NAME}/themes/${THEME_NAME}"
                            '''

                            // Copy theme files to host directory
                            sh '''
                                sshpass -p "${SSH_PASS}" rsync -avz -e "ssh -T -o LogLevel=ERROR -o BatchMode=yes -o StrictHostKeyChecking=no" ${THEME_SOURCE_DIRECTORY}/ ${SSH_USER}@${SSH_HOST}:${SERVICES_DIRECTORY}/${THEME_NAME}/themes/${THEME_NAME}/
                            '''

                            // Run the new container
                            sh '''
                                sshpass -p "${SSH_PASS}" ssh -q -o LogLevel=ERROR -o StrictHostKeyChecking=no ${SSH_USER}@${SSH_HOST} "
                                    docker run --name ${THEME_NAME} -dit --restart always \\
                                    -v ${SERVICES_DIRECTORY}/${THEME_NAME}/uploads:/var/www/html/wp-content/uploads \\
                                    -v ${SERVICES_DIRECTORY}/${THEME_NAME}/plugins:/var/www/html/wp-content/plugins \\
                                    -v ${SERVICES_DIRECTORY}/${THEME_NAME}/themes:/var/www/html/wp-content/themes \\
                                    -p 8132:80 \\
                                    -e WORDPRESS_DB_HOST=\$WORDPRESS_DB_HOST \\
                                    -e WORDPRESS_DB_USER=\$WORDPRESS_DB_USER \\
                                    -e WORDPRESS_DB_PASSWORD=\$WORDPRESS_DB_PASSWORD \\
                                    -e WORDPRESS_DB_NAME=\$WORDPRESS_DB_NAME \\
                                    ${SERVER_REG}/${THEME_NAME}:${BRANCH_NAME}-${BUILD_ID}
                                "
                            '''
                        }
                    }
                }
                echo '==== FINISHED DEPLOYMENT ===='
            }
        }
    }

    post {
        always {
            gitlabCommitStatus('jenkins') {
                updateGitlabCommitStatus name: 'build', state: 'pending'
                updateGitlabCommitStatus name: 'build', state: 'success'
            }
        }
        success {
            updateGitlabCommitStatus name: 'jenkins', state: 'success'
            slackSend(channel: slackResponse.threadId, color: 'good', message: "${JOB_NAME} build #${BUILD_NUMBER} succeeded (<${RUN_DISPLAY_URL}|Open>)", tokenCredentialId: 'slack-custome')
        }
        unstable {
            slackSend(channel: slackResponse.threadId, color: '#F48225', message: "${JOB_NAME} build #${BUILD_NUMBER} is UNSTABLE :middle_finger: at: Edgar (<${RUN_DISPLAY_URL}|Open>)", tokenCredentialId: 'slack-custome')
        }
        failure {
            updateGitlabCommitStatus name: 'jenkins', state: 'failed'
            slackSend(channel: slackResponse.threadId, color: "danger", message: "${JOB_NAME} build #${BUILD_NUMBER} failed (<${RUN_DISPLAY_URL}|Open>)", tokenCredentialId: 'slack-custome')
        }
    }
}
