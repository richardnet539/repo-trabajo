{
  "name": "web-presence-support/liga_de_debate",
  "require": {
    "wpackagist-plugin/wp-stateless": "*",
    "wpackagist-plugin/redis-cache": "*",
    "wpackagist-plugin/wp-super-cache": "*",
    "wpackagist-plugin/wp-mail-smtp": "*",
    "wpackagist-plugin/contact-form-7": "*",
    "wpackagist-plugin/wp-carousel-free": "*",
    "wpackagist-plugin/smart-slider-3": "*",
    "wpackagist-plugin/meta-box": "*",
    "cts-web/slider-inserter": "dev-main",
    "wpackagist-plugin/widget-context": "*",
    "wpackagist-plugin/classic-widgets": "*",
    "hexcss/wp-cloud-upload": "*",
    "wikimedia/composer-merge-plugin": "^2.0"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "vcs",
      "url": "https://code.ctdesarrollo-sdr.org/cts-web/wordpress/custom-plugins/slider-post-inserter.git"
    }
  ],
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "merge-plugin": {
      "include": [
        "wp-content/plugins/*/composer.json"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}