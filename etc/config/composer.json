{
  "name": "web-presence-support/liga_de_debate",
  "require": {
    "wpackagist-plugin/redis-cache": "*",
    "wpackagist-plugin/wp-super-cache": "*",
    "wpackagist-plugin/wp-mail-smtp": "*",
    "wpackagist-plugin/contact-form-7": "*",
    "wpackagist-plugin/smart-slider-3": "*",
    "wpackagist-plugin/meta-box": "*",
    "cts-web/slider-inserter": "dev-main",
    "cts-web/webform-builder": "dev-master",
    "cts-web/restrict-content-by-ip": "dev-main",
    "cts-web/secure-proxy-enabler": "dev-main",
    "wpackagist-plugin/widget-context": "*",
    "wpackagist-plugin/classic-widgets": "*",
    "wpackagist-plugin/wordfence": "*",
    "hexcss/wp-cloud-upload": "dev-master",
    "wpackagist-plugin/wp-statistics": "*"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.fbr.group/web-presence/thanos/wordpress/custom-plugins/posts-slider.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.fbr.group/web-presence/thanos/wordpress/custom-plugins/webform-builder.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.fbr.group/web-presence/thanos/wordpress/custom-plugins/restrict-content-by-ip.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.fbr.group/web-presence/thanos/wordpress/custom-plugins/secure-proxy-enabler.git"
    }
  ],
  "extra": {
    "installer-paths": {
      "wp-content/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "wp-content/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true
    }
  }
}